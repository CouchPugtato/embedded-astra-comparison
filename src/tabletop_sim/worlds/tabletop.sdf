<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tabletop">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <!-- 500 Hz is ample for the 100 Hz controller and halves idle physics work. -->
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>RGB camera view</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <!-- Keep this pose synchronized with the scene_camera model below. -->
        <camera_pose>1.3 0.85 1.3 0 0.785398 -2.356194</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
    </gui>

    <light name="key_light" type="directional">
      <pose>0 0 4 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="scene_camera">
      <static>true</static>
      <!-- 45-degree diagonal / 45-degree downward view; the robot is on the far side. -->
      <pose>1.3 0.85 1.3 0 0.785398 -2.356194</pose>
      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <topic>/camera/image_raw</topic>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.82 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision"><geometry><box><size>4 4 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The work surface is z=0, matching the Panda base frame. -->
    <model name="table">
      <static>true</static>
      <link name="table_link">
        <collision name="top_collision"><pose>0.45 0 -0.04 0 0 0</pose><geometry><box><size>1.35 0.9 0.08</size></box></geometry></collision>
        <visual name="top_visual"><pose>0.45 0 -0.04 0 0 0</pose><geometry><box><size>1.35 0.9 0.08</size></box></geometry><material><ambient>0.42 0.25 0.12 1</ambient><diffuse>0.58 0.36 0.18 1</diffuse></material></visual>
        <collision name="leg1_collision"><pose>0.95 0.32 -0.42 0 0 0</pose><geometry><box><size>0.08 0.08 0.76</size></box></geometry></collision>
        <visual name="leg1_visual"><pose>0.95 0.32 -0.42 0 0 0</pose><geometry><box><size>0.08 0.08 0.76</size></box></geometry><material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material></visual>
        <collision name="leg2_collision"><pose>0.95 -0.32 -0.42 0 0 0</pose><geometry><box><size>0.08 0.08 0.76</size></box></geometry></collision>
        <visual name="leg2_visual"><pose>0.95 -0.32 -0.42 0 0 0</pose><geometry><box><size>0.08 0.08 0.76</size></box></geometry><material><ambient>0.3 0.18 0.08 1</ambient><diffuse>0.4 0.24 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="red_cube">
      <pose>0.46 0.18 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.03 0.03 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Target cube at the bottom of a two-cube stack. -->
    <model name="red_cube_stacked_lower">
      <pose>0.68 0.10 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.03 0.03 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Distractor balanced directly on the second red target cube. -->
    <model name="green_cube_stacked_upper">
      <pose>0.68 0.10 0.075 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.02 0.55 0.08 1</ambient><diffuse>0.03 0.8 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Separate non-target distractor. -->
    <model name="yellow_cube">
      <!-- Align its center with the tray's far edge relative to the arm: 0.52 + 0.22 / 2. -->
      <pose>0.63 -0.02 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.8 0.62 0.02 1</ambient><diffuse>0.98 0.78 0.03 1</diffuse></material></visual>
      </link>
    </model>

    <model name="blue_tray">
      <pose>0.52 -0.22 0.012 0 0 0</pose>
      <link name="tray_link">
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.0015</ixx><iyy>0.0022</iyy><izz>0.0034</izz></inertia>
        </inertial>
        <collision name="base_collision">
          <geometry><box><size>0.22 0.18 0.024</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="base_visual"><geometry><box><size>0.22 0.18 0.024</size></box></geometry><material><ambient>0.02 0.12 0.8 1</ambient><diffuse>0.03 0.2 0.95 1</diffuse></material></visual>
        <collision name="rim1_collision"><pose>0.105 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.18 0.05</size></box></geometry></collision>
        <visual name="rim1_visual"><pose>0.105 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.18 0.05</size></box></geometry><material><ambient>0.02 0.12 0.8 1</ambient><diffuse>0.03 0.2 0.95 1</diffuse></material></visual>
        <collision name="rim2_collision"><pose>-0.105 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.18 0.05</size></box></geometry></collision>
        <visual name="rim2_visual"><pose>-0.105 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.18 0.05</size></box></geometry><material><ambient>0.02 0.12 0.8 1</ambient><diffuse>0.03 0.2 0.95 1</diffuse></material></visual>
        <collision name="rim3_collision"><pose>0 0.085 0.035 0 0 0</pose><geometry><box><size>0.22 0.01 0.05</size></box></geometry></collision>
        <visual name="rim3_visual"><pose>0 0.085 0.035 0 0 0</pose><geometry><box><size>0.22 0.01 0.05</size></box></geometry><material><ambient>0.02 0.12 0.8 1</ambient><diffuse>0.03 0.2 0.95 1</diffuse></material></visual>
        <collision name="rim4_collision"><pose>0 -0.085 0.035 0 0 0</pose><geometry><box><size>0.22 0.01 0.05</size></box></geometry></collision>
        <visual name="rim4_visual"><pose>0 -0.085 0.035 0 0 0</pose><geometry><box><size>0.22 0.01 0.05</size></box></geometry><material><ambient>0.02 0.12 0.8 1</ambient><diffuse>0.03 0.2 0.95 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
